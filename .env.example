NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_TOKEN=your-api-token-here

# Automatic popup only; manual CTA popups remain available when false.
NEXT_PUBLIC_LEAD_POPUP_ENABLED=true
# Non-negative seconds; missing/invalid values default to 30.
NEXT_PUBLIC_LEAD_POPUP_DELAY_SECONDS=30
# 10 digits only; tel (+91) and WhatsApp (91) are derived centrally.
NEXT_PUBLIC_PRIMARY_PHONE=9650691672
